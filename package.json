{
  "name": "tirox-ui",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @tirox-ui/docs test:e2e",
    "test:e2e:enforce": "CSP_ENFORCE=true pnpm --filter @tirox-ui/docs test:e2e",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "performance:check": "node scripts/measure-performance.mjs",
    "api:metadata": "node scripts/generate-api-metadata.mjs",
    "security:check": "node scripts/security-check.mjs && pnpm audit --audit-level high",
    "security:headers:check": "node scripts/check-csp-mode.mjs",
    "telemetry:check": "node scripts/check-no-telemetry.mjs",
    "runtime:boundary:check": "node scripts/check-universal-runtime.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "pack:check": "node scripts/check-packages.mjs",
    "changesets:check": "node scripts/check-changesets.mjs",
    "security:review": "node scripts/check-security-review.mjs",
    "zag:spike": "pnpm --filter @tirox-ui/solid exec node scripts/probe-zag-solid2.mjs",
    "contract:check": "node scripts/check-public-contract.mjs",
    "foundation:check": "node scripts/generate-api-metadata.mjs && node scripts/check-foundation-acceptance.mjs",
    "release:check": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm foundation:check && pnpm contract:check && pnpm runtime:boundary:check && pnpm telemetry:check && pnpm licenses:check && pnpm pack:check && node scripts/check-changesets.mjs --release && pnpm security:headers:check && pnpm performance:check && pnpm test:e2e && pnpm test:e2e:enforce && pnpm security:check && pnpm security:review",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@solidjs/diagnostics": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/testing-library": "catalog:",
    "@solidjs/vite-plugin": "catalog:",
    "@solidjs/web": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
